          <mxGeometry as="geometry" x="440" y="595" width="360" height="165" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;校验建议并补足候选&lt;/b&gt;&lt;br/&gt;参数白名单、拓扑、去重&lt;br/&gt;失败时用规则候选" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="595" width="360" height="165" />
