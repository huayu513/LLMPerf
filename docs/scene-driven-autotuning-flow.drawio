        <mxCell id="candidate_llm" value="&lt;b&gt;本地大模型 ②｜推荐配置&lt;/b&gt;&lt;br/&gt;输入：场景 + 能力目录&lt;br/&gt;输出：候选参数及理由" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F0E8FB;strokeColor=#8052B4;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1240" y="595" width="360" height="165" />
        </mxCell>
        <mxCell id="catalog" value="&lt;b&gt;建立可调参数目录&lt;/b&gt;&lt;br/&gt;复用 planner 基础候选&lt;br/&gt;只列允许的参数和值" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
