        <mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8052B4;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="scene_llm" target="scene_save">
          <mxGeometry relative="1" as="geometry" />
