  <diagram id="llmperf-autotune-v2" name="场景驱动自动调优">
    <mxGraphModel dx="2100" dy="1780" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="隔离区 LLMPerf｜自然语言场景驱动的自动调优流程" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=PingFang SC;fontSize=32;fontStyle=1;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="40" y="35" width="1800" height="65" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="用户只描述业务；本地大模型提取场景和提出候选，平台负责写入校验、生成测试负载、压测与选优。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=18;fontColor=#536277;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1950" height="38" as="geometry" />
        </mxCell>
        <mxCell id="legend0" value="复用现有 LLMPerf" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E5F2FF;strokeColor=#2878B8;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="40" y="162" width="345" height="52" as="geometry" />
        </mxCell>
        <mxCell id="legend1" value="调用本地大模型" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F0E8FB;strokeColor=#8052B4;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="425" y="162" width="345" height="52" as="geometry" />
        </mxCell>
        <mxCell id="legend2" value="需要新增" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="810" y="162" width="345" height="52" as="geometry" />
        </mxCell>
        <mxCell id="legend3" value="用户输入 / 输出" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F0F4F8;strokeColor=#64748B;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontStyle=1;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1195" y="162" width="345" height="52" as="geometry" />
        </mxCell>
        <mxCell id="phase0" value="① 场景理解、写入与准备" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=20;fontStyle=1;fontColor=#394A60;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="850" height="31" as="geometry" />
        </mxCell>
        <mxCell id="phase1" value="② 首批配置建议与实测" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=20;fontStyle=1;fontColor=#394A60;" vertex="1" parent="1">
          <mxGeometry x="40" y="595" width="850" height="31" as="geometry" />
        </mxCell>
        <mxCell id="phase2" value="③ 批次迭代与收敛判断" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=20;fontStyle=1;fontColor=#394A60;" vertex="1" parent="1">
          <mxGeometry x="40" y="960" width="850" height="31" as="geometry" />
        </mxCell>
        <mxCell id="phase3" value="④ 复验、对比与交付" style="text;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=20;fontStyle=1;fontColor=#394A60;" vertex="1" parent="1">
          <mxGeometry x="40" y="1415" width="850" height="31" as="geometry" />
        </mxCell>
        <mxCell id="input" value="&lt;b&gt;用户自然语言描述&lt;/b&gt;&lt;br/&gt;输入最多 8K / 输出最多 2K&lt;br/&gt;业务并发约 32；时延优先&lt;br/&gt;基础配置已有模型 / 镜像 / GPU" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F0F4F8;strokeColor=#64748B;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="40" y="270" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="scene_llm" value="&lt;b&gt;本地大模型 ①｜理解场景&lt;/b&gt;&lt;br/&gt;输入：用户原话&lt;br/&gt;输出：4 个字段的 JSON&lt;br/&gt;含糊时输出追问，不猜测" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F0E8FB;strokeColor=#8052B4;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="400" y="270" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="scene_save" value="&lt;b&gt;新增｜校验并写入场景&lt;/b&gt;&lt;br/&gt;最大输入 / 输出 token、并发、优先级&lt;br/&gt;校验数值与语义后写 experiment.json&lt;br/&gt;本次 run 保存不可变场景快照" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="800" y="270" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="probe" value="&lt;b&gt;复用｜模型与环境探测&lt;/b&gt;&lt;br/&gt;checkpoint、GPU / 拓扑、镜像&lt;br/&gt;探测 SGLang 支持的参数&lt;br/&gt;沿用 planner 的安全基线" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5F2FF;strokeColor=#2878B8;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="270" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="workload" value="&lt;b&gt;新增｜场景测试负载&lt;/b&gt;&lt;br/&gt;按最大长度构造固定测试档位&lt;br/&gt;输出上限≠实际输出；实测核对 token&lt;br/&gt;已有 JSONL 可复用原样回放" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1620" y="270" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="catalog" value="&lt;b&gt;新增｜可调参数目录&lt;/b&gt;&lt;br/&gt;按模型 / GPU / 镜像生成允许项&lt;br/&gt;取值、缺省态、依赖、拓扑约束&lt;br/&gt;定义能搜什么，不预设最优解" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1620" y="630" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="candidate_llm" value="&lt;b&gt;本地大模型 ②｜首批建议&lt;/b&gt;&lt;br/&gt;输入：场景 + 参数目录 + 安全基线&lt;br/&gt;输出：3–5 组配置及理由；JSON&lt;br/&gt;无需用户提供待调参数" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F0E8FB;strokeColor=#8052B4;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="630" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="validate" value="&lt;b&gt;新增｜候选校验与去重&lt;/b&gt;&lt;br/&gt;白名单、依赖、拓扑、显存估算&lt;br/&gt;区分“不传”与 false；生成指纹&lt;br/&gt;模型建议无效则回退规则候选" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="800" y="630" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="execute" value="&lt;b&gt;复用｜隔离压测执行&lt;/b&gt;&lt;br/&gt;Docker 起服务、固定请求回放&lt;br/&gt;实际生效参数、日志、复现脚本&lt;br/&gt;search.py / adapters.py" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5F2FF;strokeColor=#2878B8;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="400" y="630" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;复用｜指标与证据核验&lt;/b&gt;&lt;br/&gt;成功率、吞吐、TTFT / TPOT&lt;br/&gt;P95 / P99、实际输出 token&lt;br/&gt;结果绑定请求集和配置指纹" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5F2FF;strokeColor=#2878B8;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="40" y="630" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="score" value="&lt;b&gt;新增｜按场景评分&lt;/b&gt;&lt;br/&gt;在业务并发度下比较结果&lt;br/&gt;时延优先或吞吐优先&lt;br/&gt;未提供 SLO 时不虚构门槛" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="40" y="995" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;b&gt;预算用尽或已收敛？&lt;/b&gt;&lt;br/&gt;次数 / 时间预算&lt;br/&gt;连续无明显收益" style="rhombus;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF5DD;strokeColor=#A76A0C;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="400" y="995" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="batch_llm" value="&lt;b&gt;本地大模型 ③｜批次建议&lt;/b&gt;&lt;br/&gt;每 5–10 次 trial 后调用&lt;br/&gt;输入：已测配置 / 指标 / 失败 / 余量&lt;br/&gt;输出：下一批 1–3 个建议；JSON" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F0E8FB;strokeColor=#8052B4;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="800" y="995" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="&lt;b&gt;新增｜下一批候选入队&lt;/b&gt;&lt;br/&gt;合并模型建议与规则探索&lt;br/&gt;校验前不执行；压测时不调模型&lt;br/&gt;失败时使用规则搜索" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="995" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="again" value="&lt;b&gt;迭代回候选校验&lt;/b&gt;&lt;br/&gt;同一请求集下做下一批试验&lt;br/&gt;保持场景目标和预算不变" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1620" y="995" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fallback" value="&lt;b&gt;新增｜顾问失败回退&lt;/b&gt;&lt;br/&gt;模型超时 / JSON 错误 / 建议无效&lt;br/&gt;规则探索接管，不中断压测" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="800" y="1220" width="380" height="125" as="geometry" />
        </mxCell>
        <mxCell id="repeat" value="&lt;b&gt;复用｜决赛重复复验&lt;/b&gt;&lt;br/&gt;最优候选全量请求重跑&lt;br/&gt;多次采样；检查实际配置一致&lt;br/&gt;沿用现有 finalist 验证" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#E5F2FF;strokeColor=#2878B8;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="400" y="1450" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="rank" value="&lt;b&gt;新增｜确定性选优与对比&lt;/b&gt;&lt;br/&gt;安全基线 vs 推荐配置&lt;br/&gt;指定并发下的时延 / 吞吐收益&lt;br/&gt;附长度档位与适用边界" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#FFF0D9;strokeColor=#C97815;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="800" y="1450" width="380" height="170" as="geometry" />
        </mxCell>
        <mxCell id="explain_llm" value="&lt;b&gt;本地大模型 ④｜可选说明&lt;/b&gt;&lt;br/&gt;输入：已计算的对比与证据&lt;br/&gt;输出：给用户的文字解释&lt;br/&gt;不可用则生成模板报告" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F0E8FB;strokeColor=#8052B4;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1450" width="360" height="170" as="geometry" />
        </mxCell>
        <mxCell id="output" value="&lt;b&gt;输出推荐结果&lt;/b&gt;&lt;br/&gt;推荐配置、收益 / 风险&lt;br/&gt;复现脚本、试验轨迹和失败原因&lt;br/&gt;明确实际测试的长度档位" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fillColor=#F0F4F8;strokeColor=#64748B;strokeWidth=2;fontFamily=PingFang SC;fontSize=17;fontColor=#17243A;" vertex="1" parent="1">
          <mxGeometry x="1620" y="1450" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="input" target="scene_llm">
          <mxGeometry relative="1" as="geometry" />
