        <mxCell id="edge2" value="必要时追问" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8052B4;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;dashed=1;dashPattern=7 5;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="scene_llm" target="input">
