          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="catalog" target="candidate_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8052B4;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="candidate_llm" target="validate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="validate" target="execute">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="execute" target="evidence">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="evidence" target="score">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="score" target="decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge12" value="否，继续" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="decision" target="batch_llm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8052B4;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="batch_llm" target="merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;" edge="1" parent="1" source="merge" target="again">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge15" value="下一批" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5B6D82;fontFamily=PingFang SC;fontSize=14;fontColor=#394A60;dashed=1;dashPattern=7 5;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="again" target="validate">
          <mxGeometry relative="1" as="geometry">
